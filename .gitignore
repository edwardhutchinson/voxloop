.claude/worktrees/
.claude/RESUME.md
.claude/settings.local.json

/target/

# ADR-0037: the client bundle is built at release and never committed. Vite content-hashes
# its output, so committed output grows without bound and goes quietly stale.
web/dist/
web/node_modules/
web/.svelte-kit/

# The deployment file, its certificate and the store it opens are per-box.
# `voxloop.example.toml` is the one that is committed.
/voxloop.toml
/voxloop.sqlite*
*.pem

# Written by scripts/dev: a certificate, a deployment file, a store and a log, none of
# which belongs anywhere but the box it was made on.
/.dev/
